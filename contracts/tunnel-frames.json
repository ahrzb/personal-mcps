{
  "protocolVersion": "2026-07-28",
  "methods": {
    "register": "hub/register",
    "replaced": "hub/replaced"
  },
  "register": {
    "request": {
      "jsonrpc": "2.0",
      "method": "hub/register",
      "params": {
        "clientVersion": "<string>",
        "protocolVersion": "2026-07-28",
        "roles": {
          "reader": [
            "search"
          ],
          "curator": {
            "tools": [
              "publish"
            ],
            "prompts": [
              "digest_.*"
            ],
            "resources": [
              "news://feed/*"
            ]
          }
        }
      }
    },
    "forbiddenParamsKeys": [
      "app",
      "slug"
    ],
    "ack": {
      "jsonrpc": "2.0",
      "result": {
        "ok": true
      }
    },
    "rejection": {
      "jsonrpc": "2.0",
      "error": {
        "code": -32602
      }
    }
  },
  "replaced": {
    "jsonrpc": "2.0",
    "method": "hub/replaced"
  },
  "forwardedCall": {
    "metaKeys": [
      "hub/principal",
      "hub/roles",
      "io.modelcontextprotocol/clientCapabilities"
    ]
  },
  "forwardedMethods": {
    "consumerDriven": [
      "completion/complete",
      "prompts/get",
      "resources/read",
      "resources/subscribe",
      "resources/unsubscribe",
      "tools/call"
    ],
    "protocol": [
      "prompts/list",
      "resources/list",
      "resources/templates/list",
      "server/discover",
      "tools/list"
    ]
  }
}
