{
  "name": "personal-mcps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts:update": "vitest run --project worker contracts -u",
    "pmcp": "node --experimental-strip-types --env-file-if-exists=.env cli/pmcp.mts",
    "users": "node --experimental-strip-types --env-file-if-exists=.env scripts/users.mts",
    "smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/smoke.ts",
    "ship": "wrangler d1 migrations apply personal-mcps --remote && wrangler deploy && pnpm smoke"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.2",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/passkey": "1.7.1",
    "@block65/webcrypto-web-push": "2.0.0",
    "@clack/prompts": "^1.7.0",
    "@sentry/cloudflare": "^10.71.0",
    "better-auth": "^1.7.1",
    "commander": "^15.0.0",
    "hono": "^4.13.3",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.4.0",
    "uqr": "0.1.3",
    "wrap-ansi": "^10.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.8.0"
  }
}
