    "smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/smoke.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.2",
    "@sentry/cloudflare": "^10.71.0",
    "better-auth": "^1.7.1",
    "hono": "^4.13.3",
    "webpush-webcrypto": "^1.0.5",
    "ws": "^8.21.3"
  }
