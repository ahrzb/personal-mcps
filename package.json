{
  "name": "personal-mcps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "pnpm --filter @ahrzb/personal-mcp-web build",
    "dev": "pnpm run build:web && wrangler dev",
    "test": "pnpm run build:web && vitest run",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "contracts:update": "vitest run --project worker contracts -u",
    "visual:compare": "pnpm --filter @ahrzb/personal-mcp-web exec node --experimental-strip-types scripts/visual-compare.mts",
    "check:drawer": "pnpm --filter @ahrzb/personal-mcp-web exec node --experimental-strip-types scripts/drawer-check.mts",
    "pmcp": "node --experimental-strip-types --env-file-if-exists=.env cli/pmcp.mts",
    "users": "node --experimental-strip-types --env-file-if-exists=.env scripts/users.mts",
    "smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/smoke.ts",
    "ship": "pnpm run build:web && wrangler d1 migrations apply personal-mcps --remote && wrangler deploy && pnpm smoke"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@better-auth/infra": "^0.4.2",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/passkey": "1.7.1",
    "@block65/webcrypto-web-push": "2.0.0",
    "@cfworker/json-schema": "4.1.1",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@sentry/cloudflare": "^10.71.0",
    "better-auth": "^1.7.1",
    "hono": "^4.13.3",
    "marked": "18.0.13",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "5.9.3",
    "uqr": "0.1.3",
    "ws": "^8.21.3"
  }
}
