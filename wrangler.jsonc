{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-mcps",

  // The composition root (§17). It owns the Env shape below and re-exports the
  // AppConnection DO class, which wrangler resolves against this entry module.
  "main": "server/src/index.ts",

  "compatibility_date": "2026-08-20",
  // Load-bearing, not decoration: the vitest worker pool silently tolerates its
  // absence while a real deploy rejects it, so `wrangler deploy --dry-run` in CI is
  // what actually pins this flag (testing strategy §"every commit").
  //
  // `enable_request_signal` is §23.10's disconnect channel: without it `Request.signal`
  // never aborts, and the hub's abort cleanup has nothing to fire on.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],

  // Workers Logs: ops debugging only. The record of record is the D1 `audit` table
  // (§15) — these lines are never queried by the product.
  "observability": { "enabled": true },

  // The one stylesheet (§13) ships as a TEXT module, so `import styles from
  // "./pages/styles.css"` hands web.ts the bytes to serve at /styles.css — a worker has
  // no filesystem, and the alternative is a second copy of the file inside a .ts.
  // `fallthrough` keeps wrangler's own default Text rule (txt/html/sql) alive beside it.
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],

  // The shared control plane (§5): better-auth tables plus ours.
  //
  // Created 2026-08-25 (`wrangler d1 create personal-mcps`, region WEUR). Migrations:
  //   npx wrangler d1 migrations apply personal-mcps --local    # dev
  //   npx wrangler d1 migrations apply personal-mcps --remote   # prod
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-mcps",
      "database_id": "d3eeeb8a-cf84-479d-a25c-d134577d470c",
      "migrations_dir": "server/migrations"
    }
  ],

  // One DO instance per tunneled app, addressed by opaque `app.id` (§3, §6).
  //
  // HUB_SANDBOX is the §23.8 execution plane: one instance per EXACT-TOKEN digest (the DO
  // id is the digest itself), owning that token's single container. It is a Sandbox DO —
  // the class extends the pinned SDK's — and the `containers` entry below links it to the
  // image it supervises.
  "durable_objects": {
    "bindings": [
      { "name": "APP_CONNECTION", "class_name": "AppConnection" },
      { "name": "HUB_SANDBOX", "class_name": "HubSandbox" }
    ]
  },

  // §23.8: one container class, `basic` (1/4 vCPU, 1 GiB), at most ten instances
  // account-wide. This deployment cap is the authoritative capacity and spend-rate
  // guardrail; the platform may queue saturated starts rather than expose a distinct
  // refusal. The image is the repository's own Dockerfile: pinned Sandbox control binary
  // + pinned Deno.
  "containers": [
    {
      "class_name": "HubSandbox",
      "image": "./server/sandbox/Dockerfile",
      "instance_type": "basic",
      "max_instances": 10
    }
  ],
  // `new_sqlite_classes`, not `new_classes`: the class is SQLite-backed. Storage backend
  // is fixed at class creation and cannot be changed afterwards.
  //
  // v1 keeps the name the class was CREATED under: migration tags are history, and
  // rewriting v1 would tell the platform a different class had always been there,
  // orphaning every live object's storage. The 2026-09-01 lingo rename
  // (service → app) is v2's `renamed_classes` instead, which carries the state over.
  // v3 appends the hub execution plane's class; AppConnection's history is untouched.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ServiceConnection"] },
    { "tag": "v2", "renamed_classes": [{ "from": "ServiceConnection", "to": "AppConnection" }] },
    { "tag": "v3", "new_sqlite_classes": ["HubSandbox"] }
  ],

  // Daily sweep (§15, §7): expire past-deadline approvals, prune audit/approval rows
  // past the retention window, drop stale upstream-OAuth `state` rows. Each run writes
  // one `cron.swept` audit row — the cron's only monitoring.
  "triggers": { "crons": ["0 4 * * *"] },

  "vars": {
    // Canonical public https origin: scheme + host, no trailing slash, no path.
    // Every absolute URL the hub emits derives from this one value — including
    // better-auth's baseURL and cookie domain (§4: the auth instance is built
    // per-request from this var; nothing is configured on better-auth's side).
    "PUBLIC_ORIGIN": "https://personal-mcps.ahrzb.workers.dev"

    // Optional overrides — leave unset to use the defaults in server/src/limits.ts.
    // Both are strings here and parsed once by the composition root.
    // "AUDIT_RETENTION_DAYS": "7",      // default limits.RETENTION_DAYS = 7 days
    // "AUDIT_BODY_CAP_BYTES": "16384"   // default limits.AUDIT_BODY_CAP_BYTES = 16 KiB

    // The five deadlines (limits.deadlines) are configuration for the same reason —
    // but they exist so the SUITE can set one short for the row that watches it, not
    // so a deployment can retune the spec. Leave every one unset; a value that is not
    // a positive integer of milliseconds is ignored and the constant stands.
    // "PMCP_CALL_TIMEOUT_MS", "PMCP_AGGREGATED_LIST_DEADLINE_MS",
    // "PMCP_REGISTRATION_DEADLINE_MS", "PMCP_LISTEN_KEEPALIVE_MS",
    // "PMCP_LISTEN_BELL_MIN_INTERVAL_MS"
  }

  // Secrets — never values here, only names. Set each with:
  //   npx wrangler secret put <NAME>
  //
  // Required:
  //   BETTER_AUTH_SECRET   better-auth signing/session secret (§4)
  //   UPSTREAM_CREDS_KEY   AES-GCM key enveloping `upstream_auth_json` at rest (§5)
  //   VAPID_PUBLIC_KEY     Web Push VAPID public key, ES256 (§13)
  //   VAPID_PRIVATE_KEY    Web Push VAPID private key, ES256 (§13)
  //
  // Optional:
  //   BOOTSTRAP_SECRET     while unset, POST /internal/users 404s (§12). An
  //                        all-namespaces master key: set it for a use, rotate after.
  //   SENTRY_DSN           unset means Sentry is fully disabled.
}
